{
  "name": "sessionjack",
  "version": "0.1.0",
  "description": "Floating Electron toolbar for Sessionjack media-linking automation.",
  "author": "Sessionjack",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev-server=http://127.0.0.1:5173\"",
    "build": "vite build",
    "package": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "install:packaging": "npm install --include=peer",
    "dist:win": "npm run build && electron-builder --win --x64",
    "preview": "vite preview",
    "script:media-linking": "node src/scripts/run-media-linking.js"
  },
  "build": {
    "appId": "com.sessionjack.toolbar",
    "productName": "Sessionjack",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/renderer/**/*",
      "electron/**/*",
      "src/automation/**/*",
      "src/browser.js",
      "src/editor/**/*",
      "src/helpers/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "vendor/chrome-win64",
          "to": "chrome-win64",
          "filter": [
            "**/*"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.5",
    "dotenv": "^17.4.2",
    "playwright": "^1.60.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "concurrently": "^9.2.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "vite": "^7.3.3",
    "wait-on": "^9.0.10"
  }
}
