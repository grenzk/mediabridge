{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "target": "ES2022",
    "types": ["vite/client"]
  },
  "include": ["electron/**/*.cjs", "electron/**/*.js", "src/**/*.js", "vite.config.js"]
}
