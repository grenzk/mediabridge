{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "types": ["vite/client", "node"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "electron/platform/error-format.ts",
    "electron/tools/mediabridge/**/*.ts",
    "src/shared/browser/**/*.ts",
    "src/shared/config/**/*.ts",
    "src/shared/egain/**/*.ts",
    "src/shared/types/**/*.d.ts",
    "src/tools/mediabridge/**/*.ts",
    "src/tools/mediabridge/**/*.vue",
    "tests/tools/mediabridge/**/*.ts"
  ]
}
